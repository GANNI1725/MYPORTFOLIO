# Static assets: 1-year cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon and images: 1-year cache
/favicon/*
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable

# Fonts: 1-year cache
/alvera-demo/*
  Cache-Control: public, max-age=31536000, immutable

# HTML: short cache (revalidate always)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/  
  Cache-Control: public, max-age=0, must-revalidate
